name: Zero Trust Assessment

on:
  workflow_dispatch:
    inputs:
      pillar:
        description: 'Pillar to assess: All, Identity, Devices, Network, Data, Infrastructure, SecOps, AI'
        required: false
        default: 'All'
        type: choice
        options:
          - All
          - Identity
          - Devices
          - Network
          - Data
          - Infrastructure
          - SecOps
          - AI
      days:
        description: 'Number of days to query sign-in logs (1-30)'
        required: false
        default: '7'
        type: string
  schedule:
    - cron: '0 4 * * 1'

permissions:
  contents: read
  id-token: write

jobs:
  run-zero-trust-assessment:
    name: Run Zero Trust Assessment
    runs-on: windows-latest
    timeout-minutes: 180

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Validate required secrets
        shell: pwsh
        env:
          AZURE_TENANT_ID: ${{ secrets.AZURE_TENANT_ID }}
          AZURE_CLIENT_ID: ${{ secrets.AZURE_CLIENT_ID }}
          AZURE_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
          AZURE_CERTIFICATE_BASE64: ${{ secrets.AZURE_CERTIFICATE_BASE64 }}
          AZURE_CERTIFICATE_PASSWORD: ${{ secrets.AZURE_CERTIFICATE_PASSWORD }}
        run: |
          foreach ($name in @(
            'AZURE_TENANT_ID',
            'AZURE_CLIENT_ID',
            'AZURE_SUBSCRIPTION_ID',
            'AZURE_CERTIFICATE_BASE64',
            'AZURE_CERTIFICATE_PASSWORD'
          )) {
            if ([string]::IsNullOrWhiteSpace((Get-Item -Path "Env:$name" -ErrorAction SilentlyContinue).Value)) {
              throw "Missing required GitHub secret or variable: $name"
            }
          }

      - name: Install PowerShell modules
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          Set-PSRepository -Name PSGallery -InstallationPolicy Trusted
          Install-PSResource -Name ZeroTrustAssessment -Scope CurrentUser -TrustRepository -Quiet -ErrorAction Stop
          Install-Module Microsoft.Graph.Authentication -Scope CurrentUser -Force -AllowClobber -ErrorAction Stop

      - name: Run Zero Trust Assessment
        shell: pwsh
        env:
          AZURE_TENANT_ID: ${{ secrets.AZURE_TENANT_ID }}
          AZURE_CLIENT_ID: ${{ secrets.AZURE_CLIENT_ID }}
          AZURE_SUBSCRIPTION_ID: ${{ secrets.AZURE_SUBSCRIPTION_ID }}
          AZURE_CERTIFICATE_BASE64: ${{ secrets.AZURE_CERTIFICATE_BASE64 }}
          AZURE_CERTIFICATE_PASSWORD: ${{ secrets.AZURE_CERTIFICATE_PASSWORD }}
          ZT_PILLAR: ${{ inputs.pillar || 'All' }}
          ZT_DAYS: ${{ inputs.days || '7' }}
        run: |
          $ErrorActionPreference = 'Stop'

          $reportPath = Join-Path $env:GITHUB_WORKSPACE 'ZeroTrustReport'
          New-Item -ItemType Directory -Path $reportPath -Force | Out-Null

          $pfxPath = Join-Path $env:RUNNER_TEMP 'zero-trust-assessment.pfx'
          [System.IO.File]::WriteAllBytes($pfxPath, [System.Convert]::FromBase64String($env:AZURE_CERTIFICATE_BASE64))

          $securePassword = ConvertTo-SecureString -String $env:AZURE_CERTIFICATE_PASSWORD -AsPlainText -Force
          Import-PfxCertificate -FilePath $pfxPath -CertStoreLocation 'Cert:\CurrentUser\My' -Password $securePassword -Exportable | Out-Null

          $cert = Get-ChildItem -Path 'Cert:\CurrentUser\My' | Where-Object { $_.HasPrivateKey -and $_.Thumbprint -ne '' } | Sort-Object NotBefore -Descending | Select-Object -First 1
          if (-not $cert) {
            throw 'The certificate was not imported into the local certificate store.'
          }

          if (-not $cert.HasPrivateKey) {
            throw 'The certificate secret does not contain a private key.'
          }

          $days = [int]$env:ZT_DAYS
          Write-Host "Using certificate thumbprint: $($cert.Thumbprint)"
          Write-Host "Using days value: $days"

          Import-Module ZeroTrustAssessment -Force -ErrorAction Stop

          Connect-MgGraph -TenantId $env:AZURE_TENANT_ID -ClientId $env:AZURE_CLIENT_ID -Certificate $cert -NoWelcome
          Connect-ZtAssessment -TenantId $env:AZURE_TENANT_ID -ClientId $env:AZURE_CLIENT_ID -Certificate $cert -Environment Global -Service 'All'
          Invoke-ZtAssessment -Path $reportPath -Pillar $env:ZT_PILLAR -Days $days -NoBrowser -ShowLog

          Get-ChildItem -Path $reportPath -Recurse | Select-Object FullName

      - name: Upload Zero Trust assessment report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: zero-trust-assessment-${{ github.run_id }}
          path: ${{ github.workspace }}/ZeroTrustReport